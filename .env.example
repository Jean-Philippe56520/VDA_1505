# Server-side only. Never commit the real secret key.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=YOUR_SERVER_SIDE_SECRET_KEY
VDA_SUPABASE_ENABLED=false

# Scene source during migration: local | hybrid | supabase | snapshot
VDA_SCENE_BACKEND=local

# Optional runtime paths/version metadata
# VDA_1505_RUNTIME_DIR=/absolute/path/to/.vda_1505
# VDA_RUNTIME_SNAPSHOT=/absolute/path/to/runtime_snapshot.json
# VDA_APP_VERSION=<git-sha-or-release>
